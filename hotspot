#!/bin/bash

# Configuration - change these to your liking
SSID="try"
PASSWORD="testtest"
WLAN_IFACE="wlan0"
ETH_IFACE="eth0"

# Function to start the hotspot
start() {
    echo "Starting hotspot using nmcli..."
    # Run the exact command you provided
    sudo nmcli device wifi hotspot ifname "$WLAN_IFACE" ssid "$SSID" password "$PASSWORD"

    # Check and add iptables rules if missing
    if ! sudo iptables -t nat -C POSTROUTING -o "$ETH_IFACE" -j MASQUERADE 2>/dev/null; then
        echo "Adding iptables MASQUERADE rule..."
        sudo iptables -t nat -A POSTROUTING -o "$ETH_IFACE" -j MASQUERADE
    fi

    if ! sudo iptables -C FORWARD -i "$ETH_IFACE" -o "$WLAN_IFACE" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null; then
        echo "Adding FORWARD rule (eth0 -> wlan0)..."
        sudo iptables -A FORWARD -i "$ETH_IFACE" -o "$WLAN_IFACE" -m state --state RELATED,ESTABLISHED -j ACCEPT
    fi

    if ! sudo iptables -C FORWARD -i "$WLAN_IFACE" -o "$ETH_IFACE" -j ACCEPT 2>/dev/null; then
        echo "Adding FORWARD rule (wlan0 -> eth0)..."
        sudo iptables -A FORWARD -i "$WLAN_IFACE" -o "$ETH_IFACE" -j ACCEPT
    fi

    echo "Hotspot started. Clients can connect to $SSID"
}

# Function to stop the hotspot
stop() {
    echo "Stopping hotspot..."

    # Find the active hotspot connection on wlan0
    # nmcli output format: DEVICE:NAME
    active_conn=$(nmcli -t -f DEVICE,NAME connection show --active | grep "^$WLAN_IFACE:" | cut -d: -f2)

    if [ -n "$active_conn" ]; then
        echo "Bringing down connection: $active_conn"
        sudo nmcli connection down "$active_conn"
    else
        echo "No active hotspot found on $WLAN_IFACE."
    fi

    # Remove the iptables rules (optional – comment out if you want to keep them)
    echo "Removing iptables rules..."
    sudo iptables -t nat -D POSTROUTING -o "$ETH_IFACE" -j MASQUERADE 2>/dev/null
    sudo iptables -D FORWARD -i "$ETH_IFACE" -o "$WLAN_IFACE" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null
    sudo iptables -D FORWARD -i "$WLAN_IFACE" -o "$ETH_IFACE" -j ACCEPT 2>/dev/null

    echo "Hotspot stopped."
}

# Function to restart
restart() {
    stop
    sleep 2
    start
}

# Function to show status
status() {
    active_conn=$(nmcli -t -f DEVICE,NAME connection show --active | grep "^$WLAN_IFACE:" | cut -d: -f2)
    if [ -n "$active_conn" ]; then
        echo "Hotspot is active on $WLAN_IFACE (connection: $active_conn)"
    else
        echo "No hotspot active on $WLAN_IFACE"
    fi
}

# Main menu
case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0
